const nursesBySchool = {
  "emory university":375,"georgia state university":171,"kennesaw state university":162,
  "mercer university":145,"university of west georgia":97,"university of north georgia":84,
  "brenau university":61,"georgia gwinnett college":36,"herzing university":36,
  "columbus state university":29,"albany state university":8,
  "georgia college and state university":12,"reinhardt university":5,
};

function toTitle(s){return s.replace(/\b\w/g,c=>c.toUpperCase());}
function pct(v,d=1){return v!=null?(v*100).toFixed(d)+'%':'N/A';}
function fmt(v,d=2){return v!=null?v.toFixed(d):'—';}
function zFmt(v){return v!=null?(v>=0?'+':'')+v.toFixed(3):'N/A';}

const palette=['#4f8ef7','#22d3ee','#22c55e','#f59e0b','#a78bfa',
               '#f472b6','#fb923c','#34d399','#60a5fa','#e879f9',
               '#2dd4bf','#fbbf24','#818cf8'];
function sc(name){
  const base=name.split(' - ')[0];
  const keys=Object.keys(nursesBySchool);
  const i=keys.findIndex(k=>base.includes(k)||k.includes(base.split(' ')[0]));
  return palette[Math.max(i,0)%palette.length];
}

function zColor(v,alpha=0.85){
  if(v==null)return'rgba(74,92,122,0.3)';
  if(v>=0.5)return`rgba(34,197,94,${alpha})`;
  if(v>=0.1)return`rgba(34,211,238,${alpha})`;
  if(v>=-0.1)return`rgba(148,163,184,${alpha})`;
  if(v>=-0.5)return`rgba(251,191,36,${alpha})`;
  return`rgba(248,113,113,${alpha})`;
}
function zBg(v){
  if(v==null)return'rgba(74,92,122,0.08)';
  const a=Math.min(Math.abs(v)/2,0.35);
  if(v>0)return`rgba(34,197,94,${a})`;
  return`rgba(248,113,113,${a})`;
}

let charts={};
function dc(id){if(charts[id]){charts[id].destroy();delete charts[id];}}

const chartDefaults={
  responsive:true,maintainAspectRatio:false,
  plugins:{legend:{labels:{color:'#8899b8',boxWidth:10,font:{size:10}}},
    tooltip:{backgroundColor:'#0e1422',borderColor:'#1a2540',borderWidth:1,
      titleColor:'#fff',bodyColor:'#8899b8',padding:10}},
  scales:{
    x:{grid:{color:'#1a2540'},ticks:{color:'#4a5c7a'}},
    y:{grid:{color:'#1a2540'},ticks:{color:'#4a5c7a'}}
  }
};

// ═══════════════════════════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════════════════════════
function init(){
  // KPIs
  const withPass=composite.filter(d=>d.pass!=null);
  const avgPass=(withPass.reduce((s,d)=>s+d.pass,0)/withPass.length).toFixed(1)+'%';
  const withRet=composite.filter(d=>d.ret!=null);
  const avgRet=(withRet.reduce((s,d)=>s+d.ret,0)/withRet.length*100).toFixed(1)+'%';
  const withComp=composite.filter(d=>d.composite!=null).sort((a,b)=>b.composite-a.composite);
  const topComp=withComp.length?'+'+withComp[0].composite.toFixed(3):'—';
  document.getElementById('kAvgPass').textContent=avgPass;
  document.getElementById('kAvgRet').textContent=avgRet;
  document.getElementById('kTopComp').textContent=topComp;

  // Best 3
  const top3=withComp.slice(0,3);
  document.getElementById('best3').innerHTML=top3.map((d,i)=>`
    <div class="bcard">
      <div class="brank">${i+1}</div>
      <div class="bschool">${toTitle(d.s)}</div>
      <div class="bm">
        <div class="bmr"><span class="bml">COMPOSITE Z</span><span class="bmv" style="color:var(--green)">${zFmt(d.composite)}</span></div>
        <div class="bmr"><span class="bml">HARD SKILLS</span><span class="bmv" style="color:var(--blue)">${zFmt(d.hardF)}</span></div>
        <div class="bmr"><span class="bml">SOFT SKILLS</span><span class="bmv" style="color:var(--cyan)">${zFmt(d.softF)}</span></div>
        <div class="bmr"><span class="bml">NCLEX PASS</span><span class="bmv" style="color:var(--gold)">${fmt(d.pass,1)}%</span></div>
        <div class="bmr"><span class="bml">RETENTION</span><span class="bmv" style="color:var(--purple)">${pct(d.ret)}</span></div>
      </div>
    </div>`).join('');

  renderOverviewCharts();
  renderHeatmap();
  renderZCharts();
  renderRadars();
  renderTable();
}

// ═══════════════════════════════════════════════════════════════
// OVERVIEW CHARTS
// ═══════════════════════════════════════════════════════════════
function renderOverviewCharts(){
  // Composite bar
  const withC=composite.filter(d=>d.composite!=null).sort((a,b)=>b.composite-a.composite);
  dc('compBar');
  charts['compBar']=new Chart(document.getElementById('compBar').getContext('2d'),{
    type:'bar',
    data:{
      labels:withC.map(d=>toTitle(d.s.split(' - ')[0]).replace('University','Univ.')),
      datasets:[{
        label:'Composite Z-Score',
        data:withC.map(d=>+d.composite.toFixed(3)),
        backgroundColor:withC.map(d=>d.composite>=0?'rgba(34,197,94,0.7)':'rgba(248,113,113,0.7)'),
        borderColor:withC.map(d=>d.composite>=0?'#22c55e':'#f87171'),
        borderWidth:1,borderRadius:4,
      }]
    },
    options:{...chartDefaults,
      plugins:{...chartDefaults.plugins,legend:{display:false},
        tooltip:{...chartDefaults.plugins.tooltip,callbacks:{label:ctx=>`Composite Z: ${ctx.raw}`}}},
      scales:{
        x:{grid:{color:'#1a2540'},ticks:{color:'#4a5c7a',font:{size:9}}},
        y:{grid:{color:'#1a2540'},ticks:{color:'#4a5c7a'},
           title:{display:true,text:'Composite Z-Score',color:'#4a5c7a',font:{size:10}}}
      }
    }
  });

  // Hard vs soft
  const both=composite.filter(d=>d.hardF!=null&&d.softF!=null);
  dc('hardSoftBar');
  charts['hardSoftBar']=new Chart(document.getElementById('hardSoftBar').getContext('2d'),{
    type:'bar',
    data:{
      labels:both.map(d=>toTitle(d.s.split(' - ')[0]).replace('University','Univ.')),
      datasets:[
        {label:'Hard Skills (GPA+NCLEX)',data:both.map(d=>+d.hardF.toFixed(3)),backgroundColor:'rgba(79,142,247,0.7)',borderColor:'#4f8ef7',borderWidth:1,borderRadius:2},
        {label:'Soft Skills (Completion+Hours+Retention)',data:both.map(d=>+d.softF.toFixed(3)),backgroundColor:'rgba(34,211,238,0.7)',borderColor:'#22d3ee',borderWidth:1,borderRadius:2},
      ]
    },
    options:{...chartDefaults,
      scales:{
        x:{grid:{color:'#1a2540'},ticks:{color:'#4a5c7a',font:{size:9}}},
        y:{grid:{color:'#1a2540'},ticks:{color:'#4a5c7a'}}
      }
    }
  });

  // Scatter pass vs retention
  const scData=composite.filter(d=>d.pass!=null&&d.ret!=null);
  const maxN=Math.max(...scData.map(d=>{const base=d.s.split(' - ')[0];return nursesBySchool[base]||5;}));
  dc('scatter');
  charts['scatter']=new Chart(document.getElementById('scatter').getContext('2d'),{
    type:'bubble',
    data:{datasets:scData.map(d=>{
      const base=d.s.split(' - ')[0];const n=nursesBySchool[base]||5;
      return{label:toTitle(d.s),data:[{x:d.pass,y:d.ret*100,r:Math.max(5,Math.sqrt(n/maxN)*30)}],
        backgroundColor:sc(d.s)+'bb',borderColor:sc(d.s),borderWidth:1};})},
    options:{...chartDefaults,
      plugins:{...chartDefaults.plugins,legend:{display:false},
        tooltip:{...chartDefaults.plugins.tooltip,callbacks:{label:ctx=>{
          const d=scData[ctx.datasetIndex];
          return[toTitle(d.s),`Pass: ${d.pass.toFixed(1)}%`,`Retention: ${pct(d.ret)}`];
        }}}},
      scales:{
        x:{min:70,max:100,grid:{color:'#1a2540'},ticks:{color:'#4a5c7a',callback:v=>v+'%'},
           title:{display:true,text:'NCLEX Pass Rate',color:'#4a5c7a',font:{size:10}}},
        y:{min:50,max:110,grid:{color:'#1a2540'},ticks:{color:'#4a5c7a',callback:v=>v+'%'},
           title:{display:true,text:'Retention Rate',color:'#4a5c7a',font:{size:10}}}
      }
    },
    plugins:[{id:'quad',beforeDraw(chart){
      const{ctx,chartArea,scales}=chart;if(!chartArea)return;
      const xM=scales.x.getPixelForValue(89),yM=scales.y.getPixelForValue(72);
      ctx.save();ctx.fillStyle='rgba(34,197,94,0.05)';
      ctx.fillRect(xM,chartArea.top,chartArea.right-xM,yM-chartArea.top);
      ctx.strokeStyle='rgba(74,92,122,0.4)';ctx.setLineDash([4,4]);ctx.lineWidth=1;
      ctx.beginPath();ctx.moveTo(xM,chartArea.top);ctx.lineTo(xM,chartArea.bottom);ctx.stroke();
      ctx.beginPath();ctx.moveTo(chartArea.left,yM);ctx.lineTo(chartArea.right,yM);ctx.stroke();
      ctx.setLineDash([]);ctx.fillStyle='rgba(34,197,94,0.5)';ctx.font='10px IBM Plex Mono,monospace';
      ctx.fillText('BEST ZONE',xM+6,chartArea.top+13);ctx.restore();
    }}]
  });

  // GPA vs Pass
  const gpaData=composite.filter(d=>d.gpa!=null&&d.pass!=null);
  dc('gpaPass');
  charts['gpaPass']=new Chart(document.getElementById('gpaPass').getContext('2d'),{
    type:'scatter',
    data:{datasets:[{
      label:'Schools',
      data:gpaData.map(d=>({x:d.gpa,y:d.pass})),
      backgroundColor:gpaData.map(d=>sc(d.s)+'cc'),
      borderColor:gpaData.map(d=>sc(d.s)),
      borderWidth:1,pointRadius:7,pointHoverRadius:9,
    }]},
    options:{...chartDefaults,
      plugins:{...chartDefaults.plugins,legend:{display:false},
        tooltip:{...chartDefaults.plugins.tooltip,callbacks:{label:ctx=>{
          const d=gpaData[ctx.dataIndex];
          return[toTitle(d.s),`GPA: ${d.gpa.toFixed(2)}`,`Pass Rate: ${d.pass.toFixed(1)}%`];
        }}}},
      scales:{
        x:{min:2.9,max:3.75,grid:{color:'#1a2540'},ticks:{color:'#4a5c7a'},
           title:{display:true,text:'Average GPA',color:'#4a5c7a',font:{size:10}}},
        y:{min:70,max:100,grid:{color:'#1a2540'},ticks:{color:'#4a5c7a',callback:v=>v+'%'},
           title:{display:true,text:'NCLEX Pass Rate',color:'#4a5c7a',font:{size:10}}}
      }
    }
  });
}

// ═══════════════════════════════════════════════════════════════
// HEATMAP
// ═══════════════════════════════════════════════════════════════
function renderHeatmap(){
  const sorted=[...composite].sort((a,b)=>{
    if(b.composite!=null&&a.composite!=null)return b.composite-a.composite;
    if(b.composite!=null)return 1;if(a.composite!=null)return -1;
    return(b.hardF||0)-(a.hardF||0);
  });
  const cols=[
    {key:'gpaZ',label:'GPA Z'},
    {key:'passZ',label:'Pass Z'},
    {key:'hardF',label:'Hard Final'},
    {key:'compZ',label:'Completion Z'},
    {key:'retZ',label:'Retention Z'},
    {key:'softF',label:'Soft Final'},
    {key:'composite',label:'Composite'},
  ];
  let html=`<table class="heatmap"><thead><tr><th style="text-align:left">School</th>${cols.map(c=>`<th>${c.label}</th>`).join('')}</tr></thead><tbody>`;
  sorted.forEach(d=>{
    html+=`<tr><td class="row-label">${toTitle(d.s)}</td>`;
    cols.forEach(c=>{
      const v=d[c.key];
      html+=`<td style="background:${zBg(v)};color:${v!=null?(v>=0?'#86efac':'#fca5a5'):'#4a5c7a'}">${zFmt(v)}</td>`;
    });
    html+=`</tr>`;
  });
  html+=`</tbody></table>`;
  document.getElementById('heatmapWrap').innerHTML=html;
}

// ═══════════════════════════════════════════════════════════════
// Z-SCORE CHARTS
// ═══════════════════════════════════════════════════════════════
function renderZBar(id,data,key,label,title){
  const sorted=[...data].filter(d=>d[key]!=null).sort((a,b)=>b[key]-a[key]);
  dc(id);
  charts[id]=new Chart(document.getElementById(id).getContext('2d'),{
    type:'bar',
    data:{
      labels:sorted.map(d=>toTitle(d.s.split(' - ')[0]).replace('University','Univ.').replace('College','Col.')),
      datasets:[{
        label,data:sorted.map(d=>+d[key].toFixed(3)),
        backgroundColor:sorted.map(d=>zColor(d[key],0.7)),
        borderColor:sorted.map(d=>zColor(d[key])),
        borderWidth:1,borderRadius:4,
      }]
    },
    options:{...chartDefaults,indexAxis:'y',
      plugins:{...chartDefaults.plugins,legend:{display:false},
        tooltip:{...chartDefaults.plugins.tooltip,callbacks:{label:ctx=>`${label}: ${ctx.raw>=0?'+':''}${ctx.raw}`}}},
      scales:{
        x:{grid:{color:'#1a2540'},ticks:{color:'#4a5c7a'},
           title:{display:true,text:'Z-Score (0 = group average)',color:'#4a5c7a',font:{size:9}}},
        y:{grid:{display:false},ticks:{color:'#8899b8',font:{size:9}}}
      }
    }
  });
}

function renderZCharts(){
  renderZBar('zGPA',composite,'gpaZ','GPA Z-Score');
  renderZBar('zPass',composite,'passZ','NCLEX Pass Rate Z-Score');
  renderZBar('zRet',composite.filter(d=>d.ret!=null),'retZ','Retention Rate Z-Score');
  renderZBar('zComp',composite.filter(d=>d.comp!=null),'compZ','Completion % Z-Score');
}

// ═══════════════════════════════════════════════════════════════
// RADAR CHARTS
// ═══════════════════════════════════════════════════════════════
function renderRadars(){
  const withBoth=composite.filter(d=>d.hardF!=null&&d.softF!=null)
    .sort((a,b)=>(b.composite||0)-(a.composite||0));
  const grid=document.getElementById('radarGrid');
  grid.innerHTML='';
  withBoth.forEach((d,i)=>{
    const div=document.createElement('div');
    div.className='rcard'+(i<3?' highlight':'');
    div.innerHTML=`<div class="rschool">${i<3?'⭐ ':''} ${toTitle(d.s)}</div><canvas id="radar_${i}" height="220"></canvas>`;
    grid.appendChild(div);
    setTimeout(()=>{
      dc(`radar_${i}`);
      charts[`radar_${i}`]=new Chart(document.getElementById(`radar_${i}`).getContext('2d'),{
        type:'radar',
        data:{
          labels:['GPA Z','NCLEX Pass Z','Hard Score','Completion Z','Retention Z','Soft Score'],
          datasets:[{
            label:toTitle(d.s.split(' - ')[0]),
            data:[d.gpaZ??0,d.passZ??0,d.hardF??0,d.compZ??0,d.retZ??0,d.softF??0],
            backgroundColor:sc(d.s)+'33',borderColor:sc(d.s),
            borderWidth:2,pointBackgroundColor:sc(d.s),pointRadius:3,
          }]
        },
        options:{
          responsive:true,maintainAspectRatio:false,
          plugins:{legend:{display:false},
            tooltip:{backgroundColor:'#0e1422',borderColor:'#1a2540',borderWidth:1,
              titleColor:'#fff',bodyColor:'#8899b8',padding:8}},
          scales:{r:{
            grid:{color:'#1a2540'},angleLines:{color:'#1a2540'},
            pointLabels:{color:'#4a5c7a',font:{size:9}},
            ticks:{color:'#4a5c7a',backdropColor:'transparent',font:{size:8}},
            suggestedMin:-1.5,suggestedMax:1.5,
          }}
        }
      });
    },50);
  });
}

// ═══════════════════════════════════════════════════════════════
// TABLE
// ═══════════════════════════════════════════════════════════════
function renderTable(){
  const typeF=document.getElementById('typeFilter').value;
  const minPass=+document.getElementById('passFilter').value;
  const sortKey=document.getElementById('sortBy').value;

  let data=[...composite];
  if(typeF!=='all')data=data.filter(d=>d.s.toLowerCase().includes(typeF));
  if(minPass>70)data=data.filter(d=>d.pass==null||d.pass>=minPass);

  const sortMap={composite:'composite',hard:'hardF',soft:'softF',pass:'pass',gpa:'gpa'};
  const sk=sortMap[sortKey];
  data.sort((a,b)=>{
    const av=a[sk],bv=b[sk];
    if(bv!=null&&av!=null)return bv-av;
    if(bv!=null)return 1;if(av!=null)return -1;return 0;
  });

  document.getElementById('tHead').innerHTML=`<tr>
    <th>School / Program</th>
    <th>GPA</th><th>NCLEX Pass</th>
    <th>GPA Z</th><th>Pass Z</th><th>Hard Score</th>
    <th>Completion%</th><th>Retention</th>
    <th>Soft Score</th><th>Composite Z</th><th>Rating</th>
  </tr>`;

  document.getElementById('tBody').innerHTML=data.map(d=>{
    const comp=d.composite;
    const tag=comp!=null?(comp>=0.4?'<span class="tag t-top">TOP PICK</span>':comp>=0.1?'<span class="tag t-mid">PROMISING</span>':'<span class="tag t-low">MONITOR</span>'):'<span class="tag t-na">PARTIAL DATA</span>';
    return`<tr>
      <td class="sch">${toTitle(d.s)}</td>
      <td class="mono">${fmt(d.gpa,2)}</td>
      <td class="mono">${d.pass!=null?d.pass.toFixed(1)+'%':'—'}</td>
      <td class="zscore ${d.gpaZ!=null?(d.gpaZ>=0?'zpos':'zneg'):'znat'}">${zFmt(d.gpaZ)}</td>
      <td class="zscore ${d.passZ!=null?(d.passZ>=0?'zpos':'zneg'):'znat'}">${zFmt(d.passZ)}</td>
      <td class="zscore ${d.hardF!=null?(d.hardF>=0?'zpos':'zneg'):'znat'}">${zFmt(d.hardF)}</td>
      <td class="mono">${d.compPct!=null?d.compPct.toFixed(1)+'%':'—'}</td>
      <td class="mono">${d.ret!=null?pct(d.ret):'—'}</td>
      <td class="zscore ${d.softF!=null?(d.softF>=0?'zpos':'zneg'):'znat'}">${zFmt(d.softF)}</td>
      <td class="zscore ${comp!=null?(comp>=0?'zpos':'zneg'):'znat'}" style="font-weight:600">${zFmt(comp)}</td>
      <td>${tag}</td>
    </tr>`;
  }).join('');
}

// ═══════════════════════════════════════════════════════════════
// TABS
// ═══════════════════════════════════════════════════════════════
function switchTab(id){
  document.querySelectorAll('.tab').forEach((t,i)=>{
    const ids=['overview','zscores','radar','detail'];
    t.classList.toggle('active',ids[i]===id);
  });
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  document.getElementById('tab-'+id).classList.add('active');
}

window.addEventListener('DOMContentLoaded',init);
</script>
