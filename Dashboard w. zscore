<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nursing School Collaborator Dashboard v2</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@300;400;500&display=swap');
:root {
  --bg:#07090f;--surface:#0e1422;--surface2:#141d2e;--border:#1a2540;
  --blue:#4f8ef7;--cyan:#22d3ee;--green:#22c55e;--gold:#f59e0b;
  --red:#f87171;--purple:#a78bfa;--pink:#f472b6;
  --text:#dde4f0;--muted:#4a5c7a;--soft:#8899b8;
  --serif:'Syne',sans-serif;--mono:'IBM Plex Mono',monospace;--body:'Inter',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:var(--body);min-height:100vh;}
body::before{content:'';position:fixed;inset:0;
  background:radial-gradient(ellipse 80% 50% at 20% 0%,rgba(79,142,247,0.06),transparent),
             radial-gradient(ellipse 60% 40% at 80% 100%,rgba(34,211,238,0.04),transparent);
  pointer-events:none;z-index:0;}
.wrap{max-width:1440px;margin:0 auto;padding:0 28px;position:relative;z-index:1;}

/* HEADER */
header{padding:32px 0 24px;border-bottom:1px solid var(--border);margin-bottom:32px;}
.hrow{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;}
h1{font-family:var(--serif);font-size:2rem;font-weight:700;color:#fff;letter-spacing:-0.5px;line-height:1.1;}
h1 em{color:var(--cyan);font-style:normal;}
.htag{font-size:0.7rem;color:var(--muted);font-family:var(--mono);letter-spacing:2px;margin-top:6px;}
.pill{background:rgba(79,142,247,0.1);border:1px solid rgba(79,142,247,0.25);color:var(--blue);
  font-family:var(--mono);font-size:0.65rem;padding:5px 12px;border-radius:3px;letter-spacing:1.5px;}

/* TABS */
.tabs{display:flex;gap:4px;margin-bottom:28px;background:var(--surface);border:1px solid var(--border);
  border-radius:10px;padding:4px;width:fit-content;}
.tab{padding:8px 20px;border-radius:7px;font-size:0.82rem;font-weight:500;cursor:pointer;
  color:var(--soft);border:none;background:transparent;font-family:var(--body);transition:all 0.2s;}
.tab.active{background:var(--surface2);color:#fff;border:1px solid var(--border);}

/* PANELS */
.panel{display:none;}.panel.active{display:block;}

/* CONTROLS */
.controls{background:var(--surface);border:1px solid var(--border);border-radius:10px;
  padding:18px 22px;margin-bottom:24px;display:flex;gap:18px;flex-wrap:wrap;align-items:flex-end;}
.cg{display:flex;flex-direction:column;gap:5px;}
.cg label{font-size:0.65rem;color:var(--muted);font-family:var(--mono);letter-spacing:1.5px;text-transform:uppercase;}
.cg select,.cg input[type=range]{background:var(--surface2);border:1px solid var(--border);color:var(--text);
  border-radius:6px;padding:7px 11px;font-family:var(--body);font-size:0.82rem;outline:none;cursor:pointer;min-width:170px;transition:border-color 0.2s;}
.cg select:hover{border-color:var(--blue);}
.cg input[type=range]{padding:3px 0;accent-color:var(--blue);min-width:140px;}
.rv{font-family:var(--mono);font-size:0.72rem;color:var(--blue);margin-top:2px;}
.rbtn{background:transparent;border:1px solid var(--border);color:var(--muted);border-radius:6px;
  padding:7px 14px;font-family:var(--body);font-size:0.78rem;cursor:pointer;transition:all 0.2s;align-self:flex-end;}
.rbtn:hover{border-color:var(--blue);color:var(--blue);}

/* KPI */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
@media(max-width:900px){.kpis{grid-template-columns:repeat(2,1fr);}}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px 20px;position:relative;overflow:hidden;}
.kpi::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.kpi.b::after{background:linear-gradient(90deg,var(--blue),transparent);}
.kpi.c::after{background:linear-gradient(90deg,var(--cyan),transparent);}
.kpi.g::after{background:linear-gradient(90deg,var(--green),transparent);}
.kpi.o::after{background:linear-gradient(90deg,var(--gold),transparent);}
.kpi-l{font-size:0.63rem;color:var(--muted);font-family:var(--mono);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:8px;}
.kpi-v{font-family:var(--serif);font-size:1.9rem;font-weight:700;line-height:1;}
.kpi-v.b{color:var(--blue);}.kpi-v.c{color:var(--cyan);}.kpi-v.g{color:var(--green);}.kpi-v.o{color:var(--gold);}
.kpi-s{font-size:0.72rem;color:var(--muted);margin-top:5px;}

/* GRID */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px;}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-bottom:18px;}
@media(max-width:1000px){.grid2,.grid3{grid-template-columns:1fr;}}
.full{grid-column:1/-1;}
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:22px;}
.ct{font-family:var(--serif);font-size:1.05rem;font-weight:600;color:#fff;margin-bottom:3px;}
.cs{font-size:0.72rem;color:var(--muted);margin-bottom:18px;}
.ch{position:relative;}

/* BEST CARDS */
.best3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px;}
@media(max-width:800px){.best3{grid-template-columns:1fr;}}
.bcard{background:var(--surface);border:1px solid rgba(34,197,94,0.25);border-radius:10px;padding:20px;position:relative;overflow:hidden;}
.bcard::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at top left,rgba(34,197,94,0.06),transparent 60%);pointer-events:none;}
.brank{font-family:var(--serif);font-size:3rem;font-weight:700;color:rgba(34,197,94,0.12);position:absolute;top:10px;right:14px;line-height:1;}
.bschool{font-family:var(--serif);font-size:1rem;font-weight:600;color:#fff;margin-bottom:14px;line-height:1.25;text-transform:capitalize;padding-right:40px;}
.bm{display:flex;flex-direction:column;gap:7px;}
.bmr{display:flex;justify-content:space-between;align-items:center;}
.bml{font-size:0.63rem;font-family:var(--mono);color:var(--muted);letter-spacing:1px;}
.bmv{font-size:0.78rem;font-family:var(--mono);font-weight:500;}
.note-box{background:rgba(245,158,11,0.07);border:1px solid rgba(245,158,11,0.2);border-radius:8px;padding:14px 18px;margin-bottom:24px;font-size:0.78rem;color:#c4974a;line-height:1.6;}
.note-box strong{color:var(--gold);}

/* RADAR container */
.radar-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px;}
@media(max-width:900px){.radar-row{grid-template-columns:1fr;}}
.rcard{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:18px;}
.rcard.highlight{border-color:rgba(34,211,238,0.4);}
.rschool{font-family:var(--serif);font-size:0.9rem;color:#fff;margin-bottom:12px;text-transform:capitalize;}

/* TABLE */
.tbl-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;}
thead tr{border-bottom:1px solid var(--border);}
th{text-align:left;font-size:0.63rem;font-family:var(--mono);color:var(--muted);letter-spacing:1.5px;
  text-transform:uppercase;padding:0 12px 11px;white-space:nowrap;cursor:pointer;user-select:none;}
th:hover{color:var(--blue);}
td{padding:11px 12px;font-size:0.8rem;border-bottom:1px solid rgba(26,37,64,0.5);vertical-align:middle;}
tbody tr{transition:background 0.15s;}
tbody tr:hover{background:var(--surface2);}
.sch{font-weight:500;color:#fff;text-transform:capitalize;}
.mono{font-family:var(--mono);font-size:0.78rem;}
.bar-cell{display:flex;align-items:center;gap:8px;}
.bar{height:4px;border-radius:2px;background:var(--border);min-width:50px;flex:1;}
.bfill{height:100%;border-radius:2px;}
.tag{display:inline-block;font-size:0.6rem;font-family:var(--mono);padding:3px 8px;border-radius:3px;letter-spacing:0.5px;white-space:nowrap;}
.t-top{background:rgba(34,197,94,0.12);color:var(--green);border:1px solid rgba(34,197,94,0.25);}
.t-mid{background:rgba(245,158,11,0.12);color:var(--gold);border:1px solid rgba(245,158,11,0.25);}
.t-low{background:rgba(248,113,113,0.12);color:var(--red);border:1px solid rgba(248,113,113,0.25);}
.t-na{background:rgba(74,92,122,0.15);color:var(--muted);border:1px solid rgba(74,92,122,0.2);}
.zscore{font-family:var(--mono);font-size:0.78rem;}
.zpos{color:var(--green);}.zneg{color:var(--red);}.znat{color:var(--muted);}

/* Z-SCORE HEATMAP */
.heatmap{width:100%;border-collapse:collapse;font-size:0.75rem;}
.heatmap th{font-size:0.6rem;font-family:var(--mono);color:var(--muted);padding:6px 8px;text-align:center;letter-spacing:1px;}
.heatmap td{padding:7px 10px;text-align:center;font-family:var(--mono);border:1px solid rgba(26,37,64,0.4);}
.heatmap .row-label{text-align:left;color:var(--soft);font-size:0.72rem;white-space:nowrap;text-transform:capitalize;min-width:160px;}
</style>
</head>
<body>
<div class="wrap">
<header>
  <div class="hrow">
    <div>
      <h1>Nursing School <em>Collaborator</em> Analysis</h1>
      <div class="htag">EMORY HEALTHCARE · BSN PROGRAM EVALUATION · 2022–2025</div>
    </div>
    <div class="pill">COMPOSITE Z-SCORE DASHBOARD</div>
  </div>
</header>

<!-- TABS -->
<div class="tabs">
  <button class="tab active" onclick="switchTab('overview')">Overview</button>
  <button class="tab" onclick="switchTab('zscores')">Z-Score Analysis</button>
  <button class="tab" onclick="switchTab('radar')">School Profiles</button>
  <button class="tab" onclick="switchTab('detail')">All Schools</button>
</div>

<!-- ══════════════════════════ TAB 1: OVERVIEW ══════════════════════════ -->
<div class="panel active" id="tab-overview">

  <div class="note-box">
    <strong>⚠ Data coverage note:</strong> Hard skills (GPA + NCLEX pass rate) available for <strong>20 school-program combinations</strong>. 
    Soft skills (completion %, clinical hours, retention rate) available for <strong>9 schools</strong> that matched rotation data. 
    Full composite Z-score available for <strong>8 schools only</strong>. Schools without composite scores are still shown using available metrics.
  </div>

  <div class="kpis">
    <div class="kpi b"><div class="kpi-l">Schools with Full Data</div><div class="kpi-v b">8</div><div class="kpi-s">Hard + soft + composite</div></div>
    <div class="kpi c"><div class="kpi-l">Avg NCLEX Pass Rate</div><div class="kpi-v c" id="kAvgPass">—</div><div class="kpi-s">Across all programs</div></div>
    <div class="kpi g"><div class="kpi-l">Avg Retention Rate</div><div class="kpi-v g" id="kAvgRet">—</div><div class="kpi-s">Among 9 schools w/ soft data</div></div>
    <div class="kpi o"><div class="kpi-l">Top Composite Score</div><div class="kpi-v o" id="kTopComp">—</div><div class="kpi-s">Best overall collaborator</div></div>
  </div>

  <div style="font-family:var(--serif);font-size:1rem;color:#fff;margin-bottom:4px;">⭐ Top Collaborators — Full Composite Score</div>
  <div style="font-size:0.72rem;color:var(--muted);margin-bottom:14px;">Ranked by Composite Z-Score (Hard Skills + Soft Skills combined). Only schools with complete data shown.</div>
  <div class="best3" id="best3"></div>

  <div class="grid2">
    <div class="card">
      <div class="ct">Composite Z-Score Ranking</div>
      <div class="cs">Higher = better overall collaborator · Schools with complete data only</div>
      <div class="ch" style="height:280px"><canvas id="compBar"></canvas></div>
    </div>
    <div class="card">
      <div class="ct">Hard vs Soft Skills Score</div>
      <div class="cs">Comparing academic performance vs clinical/operational metrics</div>
      <div class="ch" style="height:280px"><canvas id="hardSoftBar"></canvas></div>
    </div>
    <div class="card">
      <div class="ct">NCLEX Pass Rate vs Retention Rate</div>
      <div class="cs">Bubble size = nurses hired · Green zone = ideal collaborators</div>
      <div class="ch" style="height:280px"><canvas id="scatter"></canvas></div>
    </div>
    <div class="card">
      <div class="ct">GPA vs NCLEX Pass Rate</div>
      <div class="cs">Does higher GPA correlate with better pass rates?</div>
      <div class="ch" style="height:280px"><canvas id="gpaPass"></canvas></div>
    </div>
  </div>
</div>

<!-- ══════════════════════════ TAB 2: Z-SCORES ══════════════════════════ -->
<div class="panel" id="tab-zscores">
  <div class="card" style="margin-bottom:18px;">
    <div class="ct">Z-Score Heatmap — All Metrics</div>
    <div class="cs">Green = above average · Red = below average · Each cell shows the z-score value · Schools sorted by composite score</div>
    <div class="tbl-wrap" id="heatmapWrap"></div>
  </div>
  <div class="grid2">
    <div class="card">
      <div class="ct">GPA Z-Score Distribution</div>
      <div class="cs">How each school compares to the group average GPA</div>
      <div class="ch" style="height:280px"><canvas id="zGPA"></canvas></div>
    </div>
    <div class="card">
      <div class="ct">NCLEX Pass Rate Z-Score</div>
      <div class="cs">Relative performance on licensure exam</div>
      <div class="ch" style="height:280px"><canvas id="zPass"></canvas></div>
    </div>
    <div class="card">
      <div class="ct">Retention Rate Z-Score</div>
      <div class="cs">Among 9 schools with rotation & Vizient data</div>
      <div class="ch" style="height:280px"><canvas id="zRet"></canvas></div>
    </div>
    <div class="card">
      <div class="ct">Completion % Z-Score</div>
      <div class="cs">Rotation request completion rate relative to peers</div>
      <div class="ch" style="height:280px"><canvas id="zComp"></canvas></div>
    </div>
  </div>
</div>

<!-- ══════════════════════════ TAB 3: RADAR ══════════════════════════ -->
<div class="panel" id="tab-radar">
  <div class="note-box" style="margin-bottom:18px;">
    Radar charts show each school's Z-scores across all available dimensions. <strong>Larger area = stronger overall profile.</strong>
    Schools with missing soft skill data show only hard skill axes.
  </div>
  <div class="radar-row" id="radarGrid"></div>
</div>

<!-- ══════════════════════════ TAB 4: ALL SCHOOLS ══════════════════════════ -->
<div class="panel" id="tab-detail">
  <div class="controls">
    <div class="cg">
      <label>Program Type</label>
      <select id="typeFilter" onchange="renderTable()">
        <option value="all">All Types</option>
        <option value="bachelors">Bachelors</option>
        <option value="associates">Associates</option>
        <option value="masters">Pre-Licensure Masters</option>
      </select>
    </div>
    <div class="cg">
      <label>Min NCLEX Pass Rate</label>
      <input type="range" id="passFilter" min="70" max="100" value="70" oninput="document.getElementById('passVal').textContent=this.value;renderTable()">
      <div class="rv">≥ <span id="passVal">70</span>%</div>
    </div>
    <div class="cg">
      <label>Sort By</label>
      <select id="sortBy" onchange="renderTable()">
        <option value="composite">Composite Z-Score</option>
        <option value="hard">Hard Skills Score</option>
        <option value="soft">Soft Skills Score</option>
        <option value="pass">NCLEX Pass Rate</option>
        <option value="gpa">Average GPA</option>
      </select>
    </div>
    <button class="rbtn" onclick="document.getElementById('typeFilter').value='all';document.getElementById('passFilter').value=70;document.getElementById('passVal').textContent=70;document.getElementById('sortBy').value='composite';renderTable()">↺ Reset</button>
  </div>
  <div class="card">
    <div class="ct">All Schools — Complete Data View</div>
    <div class="cs">Click column headers to sort · Z-scores show relative performance vs group average</div>
    <div class="tbl-wrap"><table><thead id="tHead"></thead><tbody id="tBody"></tbody></table></div>
  </div>
</div>

</div><!-- /wrap -->

