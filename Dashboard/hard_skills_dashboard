      <th>#</th><th>School</th><th>GPA</th><th>NCLEX avg</th><th>Composite score</th><th>Tier</th>
    </tr>
  </thead>
  <tbody>
    ${zScores.map((s,i) => {
      const barW = Math.round(((s.score + 1.5) / 2.8) * 100);
      const sign  = s.score > 0 ? '+' : '';
      return `<tr>
        <td class="rank-num">${i+1}</td>
        <td style="font-weight:500">${s.school}</td>
        <td>${s.gpa.toFixed(2)}</td>
        <td>${s.nclex.toFixed(1)}%</td>
        <td>
          <div style="display:flex;align-items:center;gap:8px;">
            <div class="bar-bg">
              <div class="bar-fill" style="width:${Math.max(4,barW)}%;background:${s.score>0?'#1D9E75':'#E24B4A'};"></div>
            </div>
            <span style="font-size:11px;min-width:36px;color:${s.score>0?'#0F6E56':'#A32D2D'}">${sign}${s.score.toFixed(2)}</span>
          </div>
        </td>
        <td>${getBadge(s.score)}</td>
      </tr>`;
    }).join('')}
  </tbody>
</table>`;
</script>
</body>
</html>
