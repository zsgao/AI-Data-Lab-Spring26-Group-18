<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GA Nursing Programs — Academic Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #ffffff;
    --bg2: #f5f5f3;
    --bg3: #efefeb;
    --txt: #1a1a1a;
    --txt2: #666660;
    --txt3: #999990;
    --border: rgba(0,0,0,0.1);
    --border2: rgba(0,0,0,0.18);
    --radius-md: 8px;
    --radius-lg: 12px;
    --radius-xl: 16px;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1a1a;
      --bg2: #242422;
      --bg3: #2e2e2c;
      --txt: #e5e5e3;
      --txt2: #999990;
      --txt3: #666660;
      --border: rgba(255,255,255,0.1);
      --border2: rgba(255,255,255,0.18);
    }
  }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg3);
    color: var(--txt);
    min-height: 100vh;
    padding: 2rem 1.5rem 3rem;
  }

  .container { max-width: 1100px; margin: 0 auto; }

  /* Header */
  .header { margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 0.5px solid var(--border2); }
  .header h1 { font-family: 'DM Serif Display', serif; font-size: 26px; font-weight: 400; color: var(--txt); letter-spacing: -0.3px; }
  .header p { font-size: 13px; color: var(--txt2); margin-top: 5px; }

  /* Metric cards */
  .metrics { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; margin-bottom: 1.5rem; }
  .metric { background: var(--bg); border: 0.5px solid var(--border); border-radius: var(--radius-md); padding: 14px 16px; }
  .metric .label { font-size: 11px; color: var(--txt3); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.06em; }
  .metric .val { font-size: 24px; font-weight: 500; color: var(--txt); line-height: 1; }
  .metric .sub { font-size: 11px; color: var(--txt3); margin-top: 4px; }

  /* Cards */
  .card { background: var(--bg); border: 0.5px solid var(--border); border-radius: var(--radius-lg); padding: 1.25rem 1.5rem; }
  .card-title { font-size: 14px; font-weight: 500; color: var(--txt); margin-bottom: 3px; }
  .card-sub { font-size: 12px; color: var(--txt2); margin-bottom: 14px; }

  .charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .full-row { margin-bottom: 16px; }

  /* Legend */
  .legend { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 12px; }
  .legend-item { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--txt2); }
  .legend-dot { width: 10px; height: 10px; border-radius: 2px; flex-shrink: 0; }

  /* Ranking table */
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  thead th { font-size: 11px; font-weight: 500; color: var(--txt2); text-align: left; padding: 7px 10px; border-bottom: 0.5px solid var(--border2); white-space: nowrap; }
  tbody td { padding: 8px 10px; border-bottom: 0.5px solid var(--border); color: var(--txt); vertical-align: middle; }
  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: var(--bg2); }
  .rank-num { font-size: 11px; color: var(--txt3); }

  .badge { display: inline-block; font-size: 10px; font-weight: 500; padding: 2px 8px; border-radius: 4px; white-space: nowrap; }
  .badge-top { background: #EAF3DE; color: #3B6D11; }
  .badge-mid { background: #FAEEDA; color: #854F0B; }
  .badge-low { background: #FCEBEB; color: #A32D2D; }

  .bar-bg { background: var(--bg3); height: 5px; border-radius: 3px; min-width: 60px; flex: 1; }
  .bar-fill { height: 5px; border-radius: 3px; }

  @media (max-width: 700px) {
    .charts-row { grid-template-columns: 1fr; }
    .metrics { grid-template-columns: repeat(2, 1fr); }
    body { padding: 1rem 1rem 2rem; }
  }
</style>
</head>
