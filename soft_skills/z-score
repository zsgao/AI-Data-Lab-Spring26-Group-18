import pandas as pd


# Load data
rot = pd.read_csv('df_accurate_sample_cleanedNames.csv')
viz = pd.read_csv('Vizient_CLEANED_FINAL.csv')

# Clean column names
rot.columns = rot.columns.str.strip()
viz.columns = viz.columns.str.strip()

# Standardize school names
rot['Schools_Cleaned'] = rot['School_Cleaned'].str.strip().str.lower()
viz['Schools_Cleaned'] = viz['education_clean'].str.strip().str.lower()

# 1. COMPLETION %
rot['Completed'] = rot['Cleaned Status'] == 'Completed'

completion = rot.groupby('Schools_Cleaned').agg(
    total=('Rotation ID', 'count'),
    completed=('Completed', 'sum')
).reset_index()
#number of rotations completed not number of nurses

completion['Completion %'] = completion['completed'] / completion['total']

# 2. AVG HOURS PER PERSON

hours = rot.groupby('Schools_Cleaned').agg(
    avg_hours=('Total Hours per Person', 'mean')
).reset_index()

# 3. RETENTION RATE (by school)
viz['terminated_flag'] = viz['termination']=='Yes'

retention = viz.groupby('Schools_Cleaned').agg(
    total_nurses=('nurse id', 'count'),
    terminated=('terminated_flag', 'sum')
).reset_index()

retention['Retention rate'] = 1 - (retention['terminated'] / retention['total_nurses'])

# Merge

df = completion[['Schools_Cleaned', 'Completion %']].merge(
    hours, on='Schools_Cleaned', how='inner'
).merge(
    retention[['Schools_Cleaned', 'Retention rate']], on='Schools_Cleaned', how='inner'
)

# Z-SCORE FUNCTION
def zscore(col):
    return (col - col.mean()) / col.std()

df['Completion % z-score'] = zscore(df['Completion %'])
df['Average hour per person z-score'] = zscore(df['avg_hours'])
df['Retention rate z-score'] = zscore(df['Retention rate'])

# FINAL SCORE
df['Final score'] = df[[
    'Completion % z-score',
    'Average hour per person z-score',
    'Retention rate z-score'
]].mean(axis=1)

# Clean column names
df = df.rename(columns={
    'avg_hours': 'Average hour per person'
})

# Save
df.to_csv('soft_skills_school_scores.csv', index=False)

print("✅ File saved with rows:", len(df))